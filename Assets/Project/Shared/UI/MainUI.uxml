<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/Shared/UI/StatBackground.uss?fileID=7433441132597879392&amp;guid=c5ec885036e6d984bae7a5d4b3752971&amp;type=3#StatBackground" />
    <ui:VisualElement name="statsContainer" style="height: 53px;">
        <ui:VisualElement name="statBackground" class="background" style="height: 20px; width: 100px; left: auto; top: auto; margin-left: 10px; margin-top: 10px;">
            <ui:Label text="$ 1000" display-tooltip-when-elided="true" name="player-money" class="statText" style="opacity: 1; width: 100px; color: rgb(255, 255, 255); font-size: 15px; -unity-text-align: middle-left;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="carry-dot" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; width: 8px; height: 8px; translate: -50% -50%; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(0, 0, 0, 0.5); border-right-color: rgba(0, 0, 0, 0.5); border-top-color: rgba(0, 0, 0, 0.5); border-bottom-color: rgba(0, 0, 0, 0.5); display: none;" />
    <ui:Label name="debug-info" picking-mode="Ignore" style="position: absolute; right: 10px; top: 10px; max-width: 280px; padding-left: 6px; padding-right: 6px; padding-top: 4px; padding-bottom: 4px; background-color: rgba(0, 0, 0, 0.55); color: rgb(255, 255, 255); font-size: 12px; white-space: normal; -unity-text-align: upper-left; display: none;" />
    <ui:VisualElement name="world-time" picking-mode="Ignore" style="position: absolute; left: 10px; top: 40px; width: 320px; padding-left: 8px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px; background-color: rgba(0, 0, 0, 0.5); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;">
        <ui:Label name="time-clock" picking-mode="Ignore" style="color: rgb(255, 255, 255); font-size: 16px; padding-left: 0; margin-left: 0;" />
        <ui:Label name="time-date" picking-mode="Ignore" style="color: rgb(255, 255, 255); font-size: 12px; padding-left: 0; margin-left: 0;" />
        <ui:Label name="time-sun" picking-mode="Ignore" style="color: rgb(255, 225, 150); font-size: 12px; padding-left: 0; margin-left: 0;" />
        <ui:VisualElement name="day-bar" picking-mode="Ignore" style="height: 8px; margin-top: 5px; background-color: rgb(22, 26, 52);">
            <ui:VisualElement name="day-bar-twilight" picking-mode="Ignore" style="position: absolute; top: 0; bottom: 0; background-color: rgb(120, 95, 150);" />
            <ui:VisualElement name="day-bar-day" picking-mode="Ignore" style="position: absolute; top: 0; bottom: 0; background-color: rgb(255, 210, 110);" />
            <ui:VisualElement name="day-bar-marker" picking-mode="Ignore" style="position: absolute; top: -3px; bottom: -3px; width: 2px; background-color: rgb(255, 255, 255);" />
        </ui:VisualElement>
        <ui:VisualElement name="year-bar" picking-mode="Ignore" style="flex-direction: row; height: 6px; margin-top: 5px;">
            <ui:VisualElement name="year-bar-marker" picking-mode="Ignore" style="position: absolute; top: -3px; bottom: -3px; width: 2px; background-color: rgb(255, 255, 255);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
